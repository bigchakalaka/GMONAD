# Secrets & config runtime — copier en `.env` (jamais commite).

# Bot Telegram (via @BotFather)
TELEGRAM_BOT_TOKEN=
# ID du chat destinataire (via getUpdates apres avoir ecrit au bot)
TELEGRAM_CHAT_ID=

# Port du dashboard HTTP
PORT=8080

# true = ne rien envoyer sur Telegram (mode test)
DRY_RUN=false

# (optionnel) surcharge du planning cron
# CRON_SCHEDULE=*/5 * * * *
